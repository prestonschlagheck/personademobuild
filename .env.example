# Voice: OpenAI Realtime. Blank keeps the browser speech mock.
OPENAI_API_KEY=

# Gmail: Google OAuth. Blank keeps the local test sign-in page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Defaults to <origin>/api/oauth/google/callback.
GOOGLE_REDIRECT_URI=
# Optional. Blank answers after 400 ms of silence; "semantic" judges from the words instead, which is slower.
VOICE_TURN_DETECTION=
# Optional. Blank requests gmail.modify (read, draft, send with the user's yes, archive, trash). "readonly" or "labels"
# (unread counts only) request less, for comparison.
GMAIL_SCOPE_MODE=

# Store: wrangler.jsonc sets STORE=durable on Cloudflare (a Durable Object per session). Blank keeps the in-memory
# store for next dev.
STORE=

# Analytics and session replay: PostHog. Blank turns both off.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Authorizes the session alarm's settle call (GET /api/cron/calls). Blank keeps that route a 404 and the alarms idle.
CRON_SECRET=

# Local only. 0 turns off the per-session logs that next dev writes to .logs/sessions.
DEV_LOG=

# Local only. 1 turns on the eval harness routes (tests/live) under `next dev`. Builds and deploys ignore it.
HARNESS=

# The public origin, for link previews. Blank uses the live workers.dev URL in a build and localhost in dev.
SITE_URL=

# Set to production by wrangler.jsonc for the deployed worker, which then refuses stand-ins and the harness.
APP_ENV=
